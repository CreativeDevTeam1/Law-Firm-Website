# Copy to .env.local. The Sanity project and dataset the site reads from.
NEXT_PUBLIC_SANITY_PROJECT_ID=6x6vo5xc
NEXT_PUBLIC_SANITY_DATASET=production

# Signs the Sanity webhook that calls /api/revalidate. Must match the webhook's secret.
SANITY_REVALIDATE_SECRET=

# Server-only CMS intake connection. Match PublicIntake:ApiKey on the CMS.
CMS_API_ORIGIN=http://localhost:5083
CMS_INTAKE_API_KEY=
